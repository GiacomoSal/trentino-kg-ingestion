@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix etype: <http://knowdive.disi.unitn.it/etype#> .
@prefix schema: <http://schema.org/> .

# --- TOURIST PROFILE (Germano Rossi from the official catalog) ---
etype:Tourist_Germano a etype:tourist ;
    etype:has_name "Germano"^^xsd:string ;
    etype:has_surname "Rossi"^^xsd:string ;
    etype:has_age "60"^^xsd:int ;
    etype:has_city "Trento"^^xsd:string ;
    etype:has_BookPlace etype:Pers_Hotel_Germano ;
    etype:has_EatAt etype:Pers_Rest_Germano ;
    etype:has_Visit etype:Pers_Museum_Germano .

# --- PERSONAL CONTEXT (Places desired by Germano) ---
etype:Pers_Hotel_Germano a etype:hotel ;
    schema:name "Best Western"^^xsd:string .

etype:Pers_Rest_Germano a etype:restaurant ;
    schema:name "FORST"^^xsd:string .

etype:Pers_Museum_Germano a etype:museum ;
    schema:name "MUSE"^^xsd:string .