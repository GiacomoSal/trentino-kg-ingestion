@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix app: <http://knowdive.disi.unitn.it/trentino-app#> .
@prefix etype: <http://teleology.kg/etype#> .
@prefix schema: <http://schema.org/> .

# Mappo la mia classe Tourist su Person di schema.org come da specifiche
app:Tourist a owl:Class ;
    rdfs:subClassOf schema:Person .

# Object properties teleologiche (il turista e i POI)
# NB: domain e range vanno messi precisi sennò GraphDB fa inferenza a caso

# Root property
app:isAt a owl:ObjectProperty ;
    rdfs:domain app:Tourist ;
    rdfs:range etype:Entity .

# Proprietà specializzate per food/beverage
app:eatsAt a owl:ObjectProperty ;
    rdfs:subPropertyOf app:isAt ;
    rdfs:domain app:Tourist ;
    rdfs:range etype:Restaurant .

app:drinksAt a owl:ObjectProperty ;
    rdfs:subPropertyOf app:isAt ;
    rdfs:domain app:Tourist ;
    rdfs:range etype:Entity .