@prefix : <http://example.org/tuoprogetto/teleontology#> .
@prefix ex: <http://example.org/tuoprogetto/data#> .
@prefix osm: <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# --- SCHEMA MINIMO (TELEOLOGY LAYER) ---
# Dichiarazione dei soli nodi e proprietà strettamente necessari all'applicazione
:Tourist a owl:Class .
:PersonalRestaurant a owl:Class .
osm:restaurant a owl:Class .
:eatsAt a owl:ObjectProperty .
:hasName a owl:DatatypeProperty .

# --- ISTANZE E DATI REALI (ABOX) ---
# Profilo del turista e azione specifica
ex:Tourist_Giacomo a :Tourist ;
    :eatsAt ex:Personal_Caffe_Trento .

# Istanza nel contesto personale unificata a OSM tramite sameAs
ex:Personal_Caffe_Trento a :PersonalRestaurant ;
    :hasName "Caffè Trento"^^xsd:string ;
    owl:sameAs <http://osm.org/node/991782724> .

# Nodo fisico di riferimento su OpenStreetMap
<http://osm.org/node/991782724> a osm:restaurant .