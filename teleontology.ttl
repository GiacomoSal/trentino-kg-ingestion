@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix etype: <http://teleology.kg/etype#> .
@prefix osm_ont: <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#> .
@prefix schema: <http://schema.org/> .

# --- CONTEXT ROOT ---
etype:Entity a owl:Class . 

# --- CLASSI BASE OSM (IMPORTATE) ---
osm_ont:catering a owl:Class .

osm_ont:restaurant a owl:Class ;
    rdfs:subClassOf osm_ont:catering ;
    rdfs:label "restaurant"@en .

osm_ont:point_restaurant a owl:Class ;
    rdfs:subClassOf osm_ont:restaurant ;
    rdfs:label "point_restaurant"@en .

osm_ont:polygon_restaurant a owl:Class ;
    rdfs:subClassOf osm_ont:restaurant ;
    rdfs:label "polygon_restaurant"@en .

# --- ALLINEAMENTO CLASSI (CONTEXT UNIFICATION) ---
etype:Restaurant a owl:Class ;
    rdfs:subClassOf etype:Entity, osm_ont:restaurant ;
    rdfs:label "Restaurant"@en .

# --- ALLINEAMENTO PROPRIETÀ (PROPERTY MAPPING) ---
schema:name a owl:DatatypeProperty .
osm_ont:name a owl:DatatypeProperty .

# Mappatura formale: definiamo che le due proprietà sono equivalenti
schema:name owl:equivalentProperty osm_ont:name .