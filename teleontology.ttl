@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix etype: <http://teleology.kg/etype#> .
@prefix osm_ont: <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#> .

# Root dell'entità per il reference context
etype:Entity a owl:Class . 

# Workaround per sistemare l'albero di classi su GraphDB e non avere nodi orfani
osm_ont:openstreetmap_place rdfs:subClassOf etype:Entity .

# --- CLASSI DOMINIO ---
# Faccio ereditare le mie classi da quelle di OSM così mi becco 
# le coordinate e gli id fisici gratis senza sbattimenti in Python

etype:Restaurant a owl:Class ;
    rdfs:subClassOf etype:Entity, osm_ont:point_restaurant .

etype:Bar a owl:Class ;
    rdfs:subClassOf etype:Entity, osm_ont:point_pub .

etype:Cafe a owl:Class ;
    rdfs:subClassOf etype:Entity, osm_ont:point_cafe .

etype:Pub a owl:Class ;
    rdfs:subClassOf etype:Entity, osm_ont:point_pub .